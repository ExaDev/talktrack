{
  "name": "talktrack",
  "description": "Narrated, cursor-driven demo recordings from Playwright: a synthetic human-feeling cursor, caption bands timed to real page events, and ffmpeg-framed output, usable inside @playwright/test specs or from standalone scripts.",
  "version": "0.0.0",
  "bugs": {
    "url": "https://github.com/ExaDev/talktrack/issues"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@eslint/js": "^10.0.1",
    "@exadev/eslint-config": "2.27.0",
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.4.0",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "globals": "^17.11.0",
    "prettier": "^3.9.6",
    "publint": "^0.3.24",
    "tsdown": "^0.23.0",
    "turbo": "^2.10.12",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.68.0",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=20"
  },
  "exports": {
    ".": {
      "types": {
        "import": "./dist/index.d.ts",
        "require": "./dist/index.d.cts"
      },
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "homepage": "https://github.com/ExaDev/talktrack#readme",
  "keywords": [
    "automation",
    "captions",
    "demo",
    "e2e",
    "narration",
    "playwright",
    "recording",
    "video"
  ],
  "license": "MIT",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "peerDependencies": {
    "@playwright/test": ">=1.55"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "registry": "https://registry.npmjs.org/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ExaDev/talktrack.git"
  },
  "scripts": {
    "_build": "tsdown",
    "_lint": "eslint . --cache --max-warnings 0",
    "_prepush": "true",
    "_test": "vitest run",
    "_test:e2e": "playwright test",
    "_typecheck": "tsc -p tsconfig.json",
    "_typecheck:attw": "attw --pack",
    "build": "turbo run _build",
    "lint": "turbo run _lint",
    "lint:fix": "eslint . --fix",
    "prepublishOnly": "pnpm run lint && pnpm run typecheck && pnpm run test && pnpm run build && publint && attw --pack",
    "prepush": "turbo run _prepush",
    "test": "turbo run _test",
    "test:e2e": "turbo run _test:e2e",
    "typecheck": "turbo run _typecheck _typecheck:attw"
  },
  "sideEffects": false,
  "type": "module",
  "types": "./dist/index.d.ts"
}
