{
  "compilerOptions": {
    // DOM is on the lib list because src/cursor.ts embeds a real browser function (the cursor overlay) that page.evaluate runs inside the recorded page; the rest of the package is Node.
    "lib": ["ES2023", "DOM"],
    "types": ["node"]
  },
  "extends": "../../tsconfig.base.json",
  // One program covers source, tests and tooling configs alike: the e2e specs import both src and @playwright/test, the unit tests import src, and type-aware ESLint needs every linted file inside exactly one project.
  "include": ["src", "test", "*.config.ts", "eslint.config.ts"]
}
