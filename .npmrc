# Fallback for pnpm releases older than 10.17, which predate pnpm-workspace.yaml's
# own settings block. pnpm-workspace.yaml (saveExact, minimumReleaseAgeExclude) is the
# real source of truth on newer pnpm, where .npmrc is registry/auth-only and these
# lines are simply ignored.
save-exact=true
minimum-release-age-exclude[]=@exadev/eslint-config
minimum-release-age-exclude[]=@exadev/semantic-release-workspace
